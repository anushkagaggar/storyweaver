# Copy to .env (never commit .env). Production secrets go in HF Space Secrets and Vercel env vars.
APP_ENV=local
LOG_LEVEL=INFO

# Shared secret between the Vercel server and the backend. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
STORYWEAVER_API_KEY=
GROQ_API_KEY=

# Sign-in (V3). Parents sign in with Google; generate each secret like the API key above.
# AUTH_SECRET (Vercel only, 32+ chars): signs the session cookie and derives each parent's pseudonymous id.
#   Changing it signs everyone out AND gives everyone a new id, so their stories stop being theirs.
# USER_TOKEN_SECRET (Vercel and the Space, as a Secret): signs the per-request X-User-Token the backend checks,
#   and the 15-minute share links. Different from the API key, so an API-key holder can't act as a parent.
AUTH_SECRET=
USER_TOKEN_SECRET=
# Google OAuth client (Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID, "Web
# application"). Authorised redirect URIs: http://localhost:3000/api/auth/callback/google and
# https://<your vercel domain>/api/auth/callback/google. Scope used: openid only (no email, name or picture).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# On Vercel set AUTH_URL=https://<your vercel domain> so the redirect URI matches exactly (compose sets localhost).
# SHARE_LINK_TTL_SECONDS=900

LLM_PLANNER=groq:openai/gpt-oss-20b
LLM_TEACHER=groq:openai/gpt-oss-120b
# Planner tuning (defaults shown)
# PLANNER_MAX_TOKENS=4000
# PLANNER_TEMPERATURE=0.7
# PLANNER_REASONING_EFFORT=low
ALLOWED_ORIGINS=http://localhost:3000

# Langfuse tracing (free Hobby plan). Off unless both keys are set. Story text is sent only when
# LANGFUSE_CAPTURE_CONTENT=true; by default traces carry metadata only (privacy by design).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_CAPTURE_CONTENT=false

# Speech-to-text (V2). "groq": Groq Whisper while quota lasts, then faster-whisper on CPU. "local": faster-whisper
# only, so voice never leaves the server (it downloads the ~460 MB "small" model on first use).
# STT_ENGINE=groq
# STT_MODEL=whisper-large-v3-turbo
# STT_LOCAL_MODEL=small
# STT_LOCAL_FALLBACK=true
# STT_LANGUAGE=en
# Text-to-speech (V2). "auto": Orpheus when a story's whole narration fits today's quota (about one story a
# day: 3,600 characters), else Kokoro on CPU. "orpheus" / "kokoro" force one engine.
# TTS_ENGINE=auto
# TTS_MODEL=canopylabs/orpheus-v1-english
# TTS_MAX_WAIT_SECONDS=120
# Kokoro's ONNX files (~350 MB for fp32) download here on first use. Keep it on D: when running on the host.
# fp32 runs ~13x faster on CPU than int8 (2.8x vs 0.2x real time), so it's the default.
# KOKORO_DIR=D:/lenovo/models/kokoro
# KOKORO_VARIANT=fp32
# Pictures (V3), stored in the same bucket as the audio. "placeholder" draws a soft wordless picture for every
# page (CPU only); "sd15" draws real ones with Stable Diffusion 1.5 on a local NVIDIA GPU (6 GB is enough;
# ~2.6 GB of weights download to the HF cache on first use; without a GPU it falls back to placeholders);
# "sdxl" uses Stable Diffusion XL, for the ZeroGPU Space (Variable IMAGE_ENGINE=sdxl; ~10 GB of weights, too big
# for 6 GB of VRAM with Docker's RAM); "none" turns pictures off. Docker compose defaults the api to sd15. Fetch
# the weights once before the first story: docker compose -f infra/docker-compose.yml --env-file .env run --rm
#   --no-deps api python -m storyweaver.imaging.sd15   (or storyweaver.imaging.sdxl)
# Every IMAGE_* setting is part of the image cache key.
# IMAGE_ENGINE=placeholder
# With sd15, the model, revision and size default to stable-diffusion-v1-5 (pinned commit) at 768x576.
# IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# IMAGE_MODEL_REVISION=main
# IMAGE_WIDTH=1152 IMAGE_HEIGHT=896 IMAGE_SAMPLER=dpmpp_2m_karras IMAGE_STEPS=25 IMAGE_GUIDANCE=6.0
# Samplers: dpmpp_2m_karras, dpmpp_2m, euler_a, euler, ddim. Sizes must be multiples of 8.
# Character consistency (sd15): later pages use page 1's picture as an IP-Adapter reference at this strength
# (0 turns it off). The IP-Adapter adds ~2.5 GB to the first download (the prefetch command fetches it too).
# IMAGE_REFERENCE_SCALE=0.4
# sd15 keeps the whole model on the GPU (4.5 GB of 6 GB, ~6 s a picture). true: one part at a time, for
# smaller GPUs, but slower and ~4 GB more RAM (with the IP-Adapter that ran out of Docker's 7.35 GB here).
# IMAGE_CPU_OFFLOAD=false
# Draw through the `illustrate` Gradio endpoint instead of in the worker: the only way on ZeroGPU, where it
# defaults to the Space's own https://$SPACE_HOST. Locally, http://localhost:7860 tests the same route.
# IMAGE_GRADIO_URL=
# IMAGE_GRADIO_TIMEOUT_SECONDS=180
# Read-only HF token (Space Secret) sent with those calls, so ZeroGPU charges this account's quota.
# HF_TOKEN=
# Our own limits (V3): stories per signed-in parent (by a keyed hash of their id), and GPU-seconds per day for all.
# VISITOR_STORIES_PER_HOUR=5
# VISITOR_STORIES_PER_DAY=15
# GPU_SECONDS_PER_DAY=900
# GPU_SECONDS_PER_IMAGE=12

# Storage. Docker compose sets these for the api container; set them here only to run the backend on the host.
# DATABASE_URL=postgresql+asyncpg://storyweaver:<POSTGRES_PASSWORD>@localhost:5432/storyweaver
# REDIS_URL=redis://localhost:6379/0
# QUOTA_SAFETY_MARGIN=0.9
# WORKER_ENABLED=true
# Stories (rows and audio) are deleted this many days after creation; 0 keeps them forever.
# STORY_RETENTION_DAYS=30 RETENTION_SWEEP_SECONDS=21600

# Local docker compose only (V0 starts these; the API uses them from V1).
POSTGRES_PASSWORD=
# Local S3 (SeaweedFS) admin credentials; choose any values (secret: at least 8 characters).
S3_ACCESS_KEY_ID=storyweaver
S3_SECRET_ACCESS_KEY=

# Narration audio storage (any S3 API). Docker compose points the api at SeaweedFS with the two keys above.
# Production (HF Space, ADR-0004) uses Backblaze B2: Variables S3_ENDPOINT_URL=https://s3.<region>.backblazeb2.com,
# S3_REGION=<region>, S3_BUCKET; Secrets S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY (a key limited to that bucket).
# S3_PUBLIC_ENDPOINT_URL= S3_CREATE_BUCKET=false AUDIO_URL_TTL_SECONDS=3600
# Opt-in live test of the B2 bucket (tests/live/test_blob_live.py); the app itself never reads these:
# BACKBLAZE_ID= BACKBLAZE_KEY= BACKBLAZE_ENDPOINT=https://s3.us-east-005.backblazeb2.com BACKBLAZE_BUCKET=

# Used from later versions (see plan.md §6.9):
# LLM_FALLBACK=local:storyweaver-qwen3-4b
# VISION=groq:qwen/qwen3.8-27b
