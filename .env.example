# Copy to .env (never commit .env). Production secrets go in HF Space Secrets and Vercel env vars.
APP_ENV=local
LOG_LEVEL=INFO

# Shared secret between the Vercel server and the backend. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
STORYWEAVER_API_KEY=
GROQ_API_KEY=

LLM_PLANNER=groq:openai/gpt-oss-20b
LLM_TEACHER=groq:openai/gpt-oss-120b
# Planner tuning (defaults shown)
# PLANNER_MAX_TOKENS=4000
# PLANNER_TEMPERATURE=0.7
# PLANNER_REASONING_EFFORT=low
ALLOWED_ORIGINS=http://localhost:3000

# Langfuse tracing (free Hobby plan). Off unless both keys are set. Story text is sent only when
# LANGFUSE_CAPTURE_CONTENT=true; by default traces carry metadata only (privacy by design).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_CAPTURE_CONTENT=false

# Storage. Docker compose sets these for the api container; set them here only to run the backend on the host.
# DATABASE_URL=postgresql+asyncpg://storyweaver:<POSTGRES_PASSWORD>@localhost:5432/storyweaver
# REDIS_URL=redis://localhost:6379/0
# QUOTA_SAFETY_MARGIN=0.9
# WORKER_ENABLED=true

# Local docker compose only (V0 starts these; the API uses them from V1).
POSTGRES_PASSWORD=
# Local S3 (SeaweedFS) admin credentials; choose any values (secret: at least 8 characters).
S3_ACCESS_KEY_ID=storyweaver
S3_SECRET_ACCESS_KEY=

# Used from later versions (see plan.md §6.9):
# BLOB_BACKEND=s3local|r2
# R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_BUCKET=
# LLM_FALLBACK=local:storyweaver-qwen3-4b
# VISION=groq:qwen/qwen3.8-27b
# STT_ENGINE=groq|local
# TTS_ENGINE=auto|orpheus|kokoro
# IMAGE_MODEL=sdxl|sd15|placeholder
# HF_TOKEN=
